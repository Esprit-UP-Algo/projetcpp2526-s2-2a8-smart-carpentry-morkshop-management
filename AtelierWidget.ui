  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: #F5F0E8;
}

QPushButton {
    background-color: #6B4423;
    color: #FAF8F3;
    border: none;
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 10pt;
    min-height: 35px;
}

QPushButton:hover {
    background-color: #8B6F47;
    border: 1px solid #6B4423;
}

QPushButton:pressed {
    background-color: #5A3820;
}

QPushButton:disabled {
    background-color: #C9B896;
    color: #9B8B5B;
}

QPushButton#btnRechercher,
QPushButton#btnReinitialiser,
QPushButton#btnExporter {
    background-color: #9B8B5B;
    color: #FAF8F3;
}

QPushButton#btnRechercher:hover,
QPushButton#btnReinitialiser:hover,
QPushButton#btnExporter:hover {
    background-color: #B5A572;
    border: 1px solid #8B6F47;
}

QPushButton#btnSupprimer {
    background-color: #A0522D;
    color: #FAF8F3;
}

QPushButton#btnSupprimer:hover {
    background-color: #C86432;
}

QPushButton#btnEnregistrer,
QPushButton#btnValider {
    background-color: #6B7B3E;
}

QPushButton#btnEnregistrer:hover,
QPushButton#btnValider:hover {
    background-color: #7E9147;
}

QGroupBox {
    background-color: #FAF8F3;
    border: 2px solid #C9B896;
    border-radius: 10px;
    margin-top: 20px;
    padding-top: 20px;
    font-weight: 600;
    font-size: 11pt;
    color: #6B4423;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 8px 16px;
    background-color: #6B4423;
    color: #FAF8F3;
    border-radius: 5px;
    left: 10px;
}

QLabel {
    color: #5A3820;
    font-size: 10pt;
    font-weight: 500;
}

QLabel#lblLogo {
    background-color: transparent;
    padding: 10px;
}

QLabel#lblTitre {
    font-size: 24pt;
    font-weight: 700;
    color: #6B4423;
    padding: 15px;
    background-color: transparent;
}

QLabel#lblSousTitre {
    font-size: 12pt;
    color: #8B6F47;
    font-weight: 600;
}

QLineEdit, QComboBox, QSpinBox, QDateEdit, QTextEdit {
    background-color: #FFFFFF;
    border: 2px solid #C9B896;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 10pt;
    color: #5A3820;
    selection-background-color: #9B8B5B;
    selection-color: #FAF8F3;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QTextEdit:focus {
    border: 2px solid #8B6F47;
    background-color: #FAF8F3;
}

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FAF8F3;
    border: 2px solid #C9B896;
    gridline-color: #E8DCC4;
    font-size: 10pt;
    border-radius: 8px;
}

QTableWidget::item {
    padding: 10px;
    border-bottom: 1px solid #E8DCC4;
}

QTableWidget::item:selected {
    background-color: #9B8B5B;
    color: #FAF8F3;
}

QHeaderView::section {
    background-color: #6B4423;
    color: #FAF8F3;
    padding: 12px 8px;
    border: none;
    font-weight: 700;
    font-size: 10pt;
}

QTabWidget::pane {
    border: 2px solid #C9B896;
    background-color: #F5F0E8;
    border-radius: 8px;
    top: -2px;
}

QTabBar::tab {
    background-color: #E8DCC4;
    color: #5A3820;
    padding: 12px 25px;
    margin-right: 3px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
    font-size: 10pt;
    min-width: 120px;
}

QTabBar::tab:selected {
    background-color: #6B4423;
    color: #FAF8F3;
}
</string>
