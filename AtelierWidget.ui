     <!-- TAB PLANIFICATION -->
     <widget class="QWidget" name="tabPlanification">
      <attribute name="title"><string>  📋 Planification  </string></attribute>
      <layout class="QHBoxLayout" name="horizontalLayout_plan">
       <property name="spacing"><number>15</number></property>
       <property name="leftMargin"><number>15</number></property>
       <property name="topMargin"><number>15</number></property>
       <property name="rightMargin"><number>15</number></property>
       <property name="bottomMargin"><number>15</number></property>

       <!-- Formulaire ajout tâche -->
       <item>
        <widget class="QGroupBox" name="groupAjouterTache">
         <property name="title"><string> ➕ Nouvelle Tâche</string></property>
         <property name="maximumWidth"><number>360</number></property>
         <layout class="QFormLayout" name="formLayoutPlan">
          <property name="leftMargin"><number>15</number></property>
          <property name="topMargin"><number>25</number></property>
          <property name="rightMargin"><number>15</number></property>
          <property name="bottomMargin"><number>15</number></property>
          <property name="verticalSpacing"><number>12</number></property>
          <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Employé :</string></property></widget></item>
          <item row="0" column="1"><widget class="QComboBox" name="comboPlanEmploye"><property name="minimumWidth"><number>200</number></property></widget></item>
          <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Commande :</string></property></widget></item>
          <item row="1" column="1"><widget class="QComboBox" name="comboPlanCommande"><property name="minimumWidth"><number>200</number></property></widget></item>
          <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Machine :</string></property></widget></item>
          <item row="2" column="1"><widget class="QComboBox" name="comboPlanMachine"><property name="minimumWidth"><number>200</number></property></widget></item>
          <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Date début :</string></property></widget></item>
          <item row="3" column="1"><widget class="QDateEdit" name="planDateDebut"><property name="calendarPopup"><bool>true</bool></property><property name="displayFormat"><string>dd/MM/yyyy</string></property></widget></item>
          <item row="4" column="0"><widget class="QLabel"><property name="text"><string>Date fin :</string></property></widget></item>
          <item row="4" column="1"><widget class="QDateEdit" name="planDateFin"><property name="calendarPopup"><bool>true</bool></property><property name="displayFormat"><string>dd/MM/yyyy</string></property></widget></item>
          <item row="5" column="0"><widget class="QLabel"><property name="text"><string>Priorité :</string></property></widget></item>
          <item row="5" column="1">
           <widget class="QComboBox" name="comboPlanPriorite">
            <item><property name="text"><string>🔴 Haute</string></property></item>
            <item><property name="text"><string>🟡 Normale</string></property></item>
            <item><property name="text"><string>🟢 Basse</string></property></item>
           </widget>
          </item>
          <item row="6" column="0"><widget class="QLabel"><property name="text"><string>Notes :</string></property></widget></item>
          <item row="6" column="1"><widget class="QTextEdit" name="planNotes"><property name="maximumHeight"><number>70</number></property></widget></item>
          <item row="7" column="0" colspan="2">
           <widget class="QPushButton" name="btnPlanAjouter">
            <property name="text"><string>✅ Assigner la Tâche</string></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <!-- Liste tâches -->
       <item>
        <layout class="QVBoxLayout" name="planListeLayout">
         <item>
