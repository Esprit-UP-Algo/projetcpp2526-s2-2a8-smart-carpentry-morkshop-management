   </rect>
  </property>
  <property name="windowTitle">
   <string>Gestion des Clients</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    QMainWindow {
        background-color: #F5EBE0;
    }
    QWidget {
        background-color: #F5EBE0;
        color: #3D2817;
        font-family: 'Segoe UI', Arial, sans-serif;
    }
    QTabWidget::pane {
        border: 2px solid #8B5A2B;
        background-color: #F5EBE0;
        border-radius: 5px;
    }
    QTabBar::tab {
        background-color: #C9B59A;
        color: #3D2817;
        padding: 10px 20px;
        margin-right: 2px;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
        font-weight: bold;
    }
    QTabBar::tab:selected {
        background-color: #8B5A2B;
        color: #F5EBE0;
    }
    QTabBar::tab:hover {
        background-color: #9B8068;
    }
    QGroupBox {
        background-color: #FFFFFF;
        border: 2px solid #8B5A2B;
        border-radius: 8px;
        margin-top: 10px;
        padding-top: 15px;
        font-weight: bold;
    }
    QGroupBox::title {
        color: #5D4037;
        subcontrol-origin: margin;
        left: 10px;
        padding: 0 5px;
    }
    QLineEdit, QTextEdit {
        background-color: #FFFFFF;
        border: 2px solid #C9B59A;
        border-radius: 5px;
        padding: 8px;
        color: #3D2817;
    }
    QLineEdit:focus, QTextEdit:focus {
        border: 2px solid #8B5A2B;
    }
    QComboBox {
        background-color: #FFFFFF;
        border: 2px solid #C9B59A;
        border-radius: 5px;
        padding: 8px;
        color: #3D2817;
    }
    QComboBox:hover {
        border: 2px solid #8B5A2B;
    }
    QComboBox::drop-down {
        border: none;
        width: 30px;
    }
    QComboBox::down-arrow {
        image: none;
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        border-top: 5px solid #8B5A2B;
        margin-right: 10px;
    }
    QPushButton {
        background-color: #8B5A2B;
        color: #F5EBE0;
        border: none;
        border-radius: 5px;
        padding: 10px 20px;
        font-weight: bold;
        font-size: 11pt;
    }
    QPushButton:hover {
        background-color: #9B8068;
    }
    QPushButton:pressed {
        background-color: #5D4037;
    }
    QPushButton#btnSupprimer {
        background-color: #5D4037;
    }
    QPushButton#btnSupprimer:hover {
        background-color: #6D4C41;
    }
    QPushButton#btnAjouter {
        background-color: #8B9B6A;
    }
    QPushButton#btnAjouter:hover {
        background-color: #9BAB7A;
    }
    QPushButton#btnVider {
        background-color: #C9B59A;
        color: #3D2817;
    }
    QPushButton#btnVider:hover {
        background-color: #D9C5AA;
    }
    QTableWidget {
        background-color: #FFFFFF;
        alternate-background-color: #F5EBE0;
        border: 2px solid #C9B59A;
        border-radius: 5px;
        gridline-color: #C9B59A;
        color: #3D2817;
    }
    QTableWidget::item:selected {
        background-color: #8B5A2B;
        color: #F5EBE0;
    }
    QHeaderView::section {
        background-color: #8B5A2B;
        color: #F5EBE0;
        padding: 8px;
        border: none;
        font-weight: bold;
    }
    QPushButton#btnClient {
        background-color: #C9B59A;
        color: #3D2817;
        border: none;
        border-left: 0px solid #8B5A2B;
        border-radius: 0;
        padding: 20px 15px;
        font-size: 15pt;
        font-weight: bold;
        text-align: left;
    }
    QPushButton#btnClient:hover {
        background-color: #9B8068;
        color: white;
    }
    QPushButton#btnClient:checked {
        background-color: #8B5A2B;
        color: #F5EBE0;
        border-left: 6px solid #5D4037;
    }
    QPushButton#btnClient:pressed {
        background-color: #5D4037;
        color: white;
    }
   </string>
  </property>
